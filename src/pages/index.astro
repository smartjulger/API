---
import Planetsnav from "../components/planetsnav.astro";
import "../../styles/main.css";

const apiKey = import.meta.env.SOLAR_API_KEY ?? "";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Three.js solar system</title>
  </head>

  <body>
    <Planetsnav />

    <!-- Info paneel -->
    <aside id="info-panel" class="hidden">
      <button id="info-close" aria-label="Close">✕</button>
      <h2 id="info-name">—</h2>
      <p id="info-type" class="info-type"></p>

      <div class="info-row">
        <span class="info-label">Gravity</span>
        <span class="info-value" id="info-gravity">—</span>
      </div>
      <div class="info-row">
        <span class="info-label">Mass</span>
        <span class="info-value" id="info-mass">—</span>
      </div>
      <div class="info-row">
        <span class="info-label">Mean radius</span>
        <span class="info-value" id="info-radius">—</span>
      </div>
      <div class="info-row">
        <span class="info-label">Avg temperature</span>
        <span class="info-value" id="info-temp">—</span>
      </div>
      <div class="info-row">
        <span class="info-label">Density</span>
        <span class="info-value" id="info-density">—</span>
      </div>
      <div class="info-row">
        <span class="info-label">Escape velocity</span>
        <span class="info-value" id="info-escape">—</span>
      </div>
      <div class="info-row">
        <span class="info-label">Orbital period</span>
        <span class="info-value" id="info-orbit">—</span>
      </div>
      <div class="info-row">
        <span class="info-label">Rotation period</span>
        <span class="info-value" id="info-rotation">—</span>
      </div>
      <div class="info-row">
        <span class="info-label">Moons</span>
        <span class="info-value" id="info-moons">—</span>
      </div>
    </aside>

    <script>
      // @ts-nocheck
      import "/script/solar.js";
    </script>
  </body>
</html>
