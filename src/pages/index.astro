---
import Planetsnav from "../components/planetsnav.astro";
import "../../styles/main.css";

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Three.js solar system</title>
  </head>

  <body>
    <Planetsnav />

    <!-- Info paneel -->
    <aside id="info-panel" class="hidden">
      <button id="info-close" aria-label="Close">← BACK</button>

      <!-- Links: planeet naam + type -->
      <div class="panel-identity">
        <h2 id="info-name">—</h2>
        <p id="info-type" class="info-type"></p>
      </div>

      <!-- Rechts: statistieken -->
      <div class="panel-stats">
        <div class="stat-group">
          <span class="stat-label">Gravity</span>
          <span class="stat-value" id="info-gravity">—</span>
        </div>
        <div class="stat-group">
          <span class="stat-label">Mass</span>
          <span class="stat-value" id="info-mass">—</span>
        </div>
        <div class="stat-group">
          <span class="stat-label">Mean radius</span>
          <span class="stat-value" id="info-radius">—</span>
        </div>
        <div class="stat-group">
          <span class="stat-label">Avg temperature</span>
          <span class="stat-value" id="info-temp">—</span>
        </div>
        <div class="stat-group">
          <span class="stat-label">Density</span>
          <span class="stat-value" id="info-density">—</span>
        </div>
        <div class="stat-group">
          <span class="stat-label">Escape velocity</span>
          <span class="stat-value" id="info-escape">—</span>
        </div>
        <div class="stat-group">
          <span class="stat-label">Orbital period</span>
          <span class="stat-value" id="info-orbit">—</span>
        </div>
        <div class="stat-group">
          <span class="stat-label">Rotation period</span>
          <span class="stat-value" id="info-rotation">—</span>
        </div>
        <div class="stat-group">
          <span class="stat-label">Moons</span>
          <span class="stat-value" id="info-moons">—</span>
        </div>
      </div>

      <!-- Onderste balk -->
      <div class="panel-bottom-bar">
        <div class="bottom-accent"></div>
      </div>
    </aside>

    <script>
      // @ts-nocheck
      import "/script/solar.js";
    </script>
  </body>
</html>
