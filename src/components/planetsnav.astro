---
const planets = [
  { id: "sun",     label: "☀️ Zon" },
  { id: "mercury", label: "🪨 Mercurius" },
  { id: "venus",   label: "🌕 Venus" },
  { id: "earth",   label: "🌍 Aarde" },
  { id: "moon",    label: "🌑 Maan" },
  { id: "mars",    label: "🔴 Mars" },
  { id: "jupiter", label: "🟠 Jupiter" },
  { id: "saturn",  label: "🪐 Saturnus" },
  { id: "uranus",  label: "🔵 Uranus" },
  { id: "neptune", label: "💙 Neptunus" },
  { id: "pluto",   label: "⚪ Pluto" },
];
---

<nav id="planet-nav">
  {planets.map((p) => <button data-planet={p.id}>{p.label}</button>)}
</nav>

<style>
  #planet-nav {
    position: fixed;
    top: 20px;
    left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
  }

  #planet-nav button {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 7px 14px;
    border-radius: 8px;
    cursor: pointer;
    backdrop-filter: blur(6px);
    font-size: 13px;
    text-align: left;
  }

  #planet-nav button:hover {
    background: rgba(255, 255, 255, 0.25);
  }
</style>
